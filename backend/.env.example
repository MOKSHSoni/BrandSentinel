# Copy to backend/.env for local development. Every value has a working local default.
DATABASE_URL=postgresql+psycopg://postgres:brandsentinel@localhost:5432/brandsentinel
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000

# Local model via Ollama (default for every sensitivity tier)
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Optional external model behind the Confidentiality Gateway (any OpenAI-compatible API).
# Used only when no local model is available, and only for public content unless the admin approves a tier.
EXTERNAL_LLM_URL=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_API_KEY=

# Fix "today" for fact-validity checks so a demo is repeatable (YYYY-MM-DD). Empty = real date.
REVIEW_DATE=
